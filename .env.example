# Copy this file to .env before running `docker compose up`.
# Every value here is consumed via environment variables only — no service
# hardcodes configuration (see architecture/database-design.md and
# architecture/repository-structure.md). This same shape maps directly onto
# Kubernetes ConfigMaps (non-secret values) and Secrets (JWT_*, credentials).

# ---- Shared / cross-cutting ----
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Rate limiting (gateway only — Phase 6, see
# shared/middleware.RateLimit's doc comment for why it's not per-service) ----
# Per-client-IP token bucket: RATE_LIMIT_REQUESTS_PER_SECOND sustained,
# bursts up to RATE_LIMIT_BURST allowed above that.
RATE_LIMIT_REQUESTS_PER_SECOND=10
RATE_LIMIT_BURST=20

# ---- Request body size limit (gateway only — Phase 6, see
# shared/middleware.BodyLimit's doc comment for why it's not per-service) ----
# Caps total JSON request body size in bytes, protecting the public,
# unauthenticated auth routes from an oversized-body CPU/memory exhaustion
# attack. 1 MiB is generous relative to every real request body this app
# sends.
MAX_REQUEST_BODY_BYTES=1048576

# ---- Auth (shared secrets — user-service signs, gateway verifies) ----
# Local-only placeholder values. Never reuse these outside local dev.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# ---- Ports ----
GATEWAY_PORT=8080
USER_SERVICE_PORT=8081
EXPENSE_SERVICE_PORT=8082
BUDGET_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8084
FRONTEND_PORT=3000

# ---- Downstream service addresses (docker-compose network) ----
# Primarily consumed by the gateway to route/proxy every request, but also
# reused by any service that makes its own internal REST call to another
# service (the only sanctioned form of SYNCHRONOUS service-to-service
# traffic, per CLAUDE.md §3): budget-service reads EXPENSE_SERVICE_URL for
# its Phase 3 reports call and its Phase 7 overspend recomputation (see
# architecture/api-contracts.md). NOTIFICATION_SERVICE_URL is read only by
# the gateway now — budget-service's Phase 4 REST call to
# notification-service was replaced in Phase 7 by a published
# finora.budget.overspent event (see the NATS section below), so
# budget-service no longer calls notification-service directly at all.
USER_SERVICE_URL=http://user-service:8081
EXPENSE_SERVICE_URL=http://expense-service:8082
BUDGET_SERVICE_URL=http://budget-service:8083
NOTIFICATION_SERVICE_URL=http://notification-service:8084

# ---- NATS (Phase 7 — async domain events) ----
# One shared JetStream-enabled NATS instance for the whole fleet.
# expense-service publishes finora.transaction.created; budget-service
# consumes it and publishes finora.budget.overspent; notification-service
# consumes that. See architecture/api-contracts.md's Async Events section.
NATS_URL=nats://nats:4222
NATS_PORT=4222
# How often each publishing service's outbox relay polls for unpublished
# events and retries publishing them to NATS (expense-service,
# budget-service — notification-service only consumes, it has no outbox).
OUTBOX_RELAY_INTERVAL=2s

# ---- Per-service MongoDB (one instance per service — never shared) ----
USER_SERVICE_MONGO_URI=mongodb://mongo-user:27017/finora_users
EXPENSE_SERVICE_MONGO_URI=mongodb://mongo-expense:27017/finora_expenses
BUDGET_SERVICE_MONGO_URI=mongodb://mongo-budget:27017/finora_budgets
NOTIFICATION_SERVICE_MONGO_URI=mongodb://mongo-notification:27017/finora_notifications

# ---- MongoDB host ports (for connecting a local client, e.g. MongoDB
# Compass, directly to a service's database — not used by the services
# themselves, which always talk to each other over the docker network by
# container name on the container-internal 27017, per the URIs above) ----
MONGO_USER_PORT=27017
MONGO_EXPENSE_PORT=27018
MONGO_BUDGET_PORT=27019
MONGO_NOTIFICATION_PORT=27020

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
